            "name": "Debug window_sieve",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/window_sieve", // Path to the executable
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false, // Set to true to use an external console
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb", // Path to GDB (adjust if needed)
